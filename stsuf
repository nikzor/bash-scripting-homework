#!/bin/bash

if (( $# != 1 )); then
    echo "Использование: $0 каталог" >&2
    exit 1
fi
if [[ ! -d "$1" ]]; then
    echo "Ошибка: это не каталог: $1" >&2
    exit 1
fi
dir=$(cd -- "$1" && pwd -P) || exit 1
declare -A counts

while IFS= read -r -d '' file; do
    name=${file##*/}
    # Пропускаем первый символ: начальная точка не обозначает суффикс.
    if [[ "${name:1}" == *.* ]]; then
        suffix=.${name##*.}
    else
        suffix='no suffix'
    fi
    counts["$suffix"]=$(( ${counts["$suffix"]:-0} + 1 ))
done < <(find "$dir" -type f -print0)

# Каждый раз выводим оставшийся суффикс с наибольшим количеством файлов.
while (( ${#counts[@]} > 0 )); do
    largest=''
    maximum=0
    for suffix in "${!counts[@]}"; do
        if (( ${counts["$suffix"]} > maximum )); then
            largest=$suffix
            maximum=${counts["$suffix"]}
        fi
    done
    printf '%s: %s\n' "$largest" "$maximum"
    unset 'counts[$largest]'
done
